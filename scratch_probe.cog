-- probe basic assumptions
note 5m
note 2h
note 14:30
note 00:03
note (0 - 7) % 3
note 7 % 3
note "abc".slice(1)
note "a-b-c".split("-").size
note "".split("x").size
note "x".lowercase isnt "x".uppercase
note "1".lowercase isnt "1".uppercase
hold m = [:]
m["a"] = 1
note m
hold xs = []
xs[0] = 5
note xs
note 3.7.floor
note (0 - 3.7).floor
note "ab".padded(5, "*")
note 10 / 4
note "hi".repeat(3)
note [1,2,3].fold(0, verb (a, b) { give a + b })
hold t = "x"
note "@(t)y"
note [[1,2],[3]].size
note kind([1])
note 2.5.whole
